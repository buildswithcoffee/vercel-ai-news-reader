{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }
      ]
    },
    "api": {
      "root": "api/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/ingest", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/ingest", "schedule": "*/15 * * * *" }],
  "daemons": {
    "scorer": {
      "root": "scorer/",
      "entrypoint": "Dockerfile",
      "instances": { "iad1": 1 }
    }
  }
}
