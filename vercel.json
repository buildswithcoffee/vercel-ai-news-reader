{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_INTERNAL_URL" }
      ]
    },
    "api": {
      "root": "api/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "daemons": {
    "scorer": {
      "root": "scorer/",
      "entrypoint": "Dockerfile",
      "instances": { "iad1": 1 }
    }
  }
}
